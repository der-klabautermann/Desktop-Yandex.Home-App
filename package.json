{
  "name": "yandex-smart-home-control",
  "private": true,
  "version": "2.0.5",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron-dev": "npm run build:core && node scripts/electron-wait-for-vite.js",
    "build": "npm run build:core && vite build",
    "dist": "npm run build && electron-builder",
    "preview": "vite preview",
    "test": "vitest run --root .",
    "preview:web": "vite --port 5174 --strictPort",
    "build:core": "node scripts/build-core.mjs"
  },
  "dependencies": {
    "@fontsource/comfortaa": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "fetch-cookie": "^3.2.0",
    "hls.js": "^1.6.16",
    "keytar": "^7.9.0",
    "lucide-react": "^0.555.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tough-cookie": "^6.0.1"
  },
  "devDependencies": {
    "@types/keytar": "^4.4.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^39.8.10",
    "electron-builder": "^25.1.0",
    "esbuild": "^0.25.12",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  },
  "author": "История Одного Геймера <gamecuts0412@gmail.com>",
  "description": "Yandex Smart Home Control Application",
  "build": {
    "appId": "com.onegamerstory.smarthomecontrol",
    "productName": "Yandex Smart Home Control",
    "artifactName": "${productName} Setup v${version}.${ext}",
    "icon": "resources/icon.png",
    "files": [
      "dist/**/*",
      "electron/*.js",
      "electron/*.cjs",
      "node_modules/**/*",
      "resources/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName} Setup v${version}-${arch}.${ext}",
      "icon": "resources/icon.icns",
      "extendInfo": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "dmg": {
      "title": "Smart Home Control Installer",
      "iconSize": 128,
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "icon": "resources/linux-icons",
      "maintainer": "История Одного Геймера <gamecuts0412@gmail.com>",
      "description": "Yandex Smart Home Control Application",
      "executableName": "yandex-smart-home-control",
      "desktop": {
        "StartupWMClass": "yandex-smart-home-control"
      }
    }
  }
}
